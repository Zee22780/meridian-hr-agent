# Meridian HR Agent — environment template
#
# Copy to backend/.env and fill in real values. Never commit the filled copy.
#     cp .env.example backend/.env

# ── Database (Neon) ──────────────────────────────────────────────────────────
#
# Use the POOLED connection string — the hostname contains "-pooler".
# Grab it from the Neon console under Connect.
#
# Neon appends ?sslmode=require&channel_binding=require to the strings it hands
# out. Paste it as-is: app/config.py strips those libpq-only params, which
# asyncpg would otherwise reject, and enforces TLS via connect_args instead.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-12345678-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# The DIRECT (non-pooled) endpoint — same string without "-pooler" in the host.
# Not read by the app; used only for one-off DDL, since PgBouncer's transaction
# mode disables the session features CREATE EXTENSION and DDL rely on:
#     psql "$NEON_DIRECT_URL" -c "CREATE EXTENSION IF NOT EXISTS vector;"
#     psql "$NEON_DIRECT_URL" -f scripts/init_db.sql
NEON_DIRECT_URL=postgresql://USER:PASSWORD@ep-example-12345678.us-east-1.aws.neon.tech/neondb?sslmode=require

# A Neon BRANCH of main, used by the write-heavy scripts in scripts/.
# Create it in the Neon console: Branches → New branch, parent `main`. A branch
# is a copy-on-write clone, so it already contains the ingested policy chunks —
# no re-embedding needed. Use its POOLED string here.
#
# The test scripts have no fixtures and no rollback, so they refuse to run
# without this. Override deliberately with: ALLOW_MAIN_DB=1 python <script>
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-branch-87654321-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── API keys ─────────────────────────────────────────────────────────────────

# Agent reasoning and tool use
ANTHROPIC_API_KEY=sk-ant-...

# Embeddings only — text-embedding-3-small, 1536d
OPENAI_API_KEY=sk-...
